nd&quot;" /></stage><stage stageid="f2fc4e1d-3689-4515-ae9b-9fc4d6e99138" name="Email is not Collection" type="Decision"><subsheetid>64349ece-385a-4c8a-b8b1-c50ac84c9a1d</subsheetid><display x="15" y="-30" w="120" h="30" /><decision expression="Trim([Emails Collection.Body]) &lt;&gt; &quot;&quot;" /><ontrue>0db8c84d-bad7-42ab-b967-60c82a095a3e</ontrue><onfalse>d69a915c-59e5-4c4b-b079-9ed2746a6d1d</onfalse></stage><stage stageid="0db8c84d-bad7-42ab-b967-60c82a095a3e" name="Mark Email As Read" type="Action"><subsheetid>64349ece-385a-4c8a-b8b1-c50ac84c9a1d</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" w="120" h="30" /><inputs><input type="text" name="Entry ID" friendlyname="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." expr="[Emails Collection.EntryID]" /></inputs><onsuccess>bdd27b06-a52b-4df6-b536-810549c00688</onsuccess><resource object="MS Outlook Email VBO" action="Mark Email As Read" /></stage><stage stageid="d69a915c-59e5-4c4b-b079-9ed2746a6d1d" name="Exception2" type="Exception"><subsheetid>64349ece-385a-4c8a-b8b1-c50ac84c9a1d</subsheetid><display x="150" y="-30" /><exception localized="yes" type="Business Exception" detail="&quot;BE:Email is null&quot;" /></stage><stage stageid="c4f65720-ad63-49f0-89ed-b985b12b83dd" name="Emails Collection" type="Collection"><subsheetid>64349ece-385a-4c8a-b8b1-c50ac84c9a1d</subsheetid><display x="-180" y="45" w="210" h="60" /><datatype>collection</datatype><alwaysinit /></stage><stage stageid="9832a7c2-e8c1-4b4c-83b9-775d6663ad6a" name="Reset Global Data" type="SubSheetInfo"><subsheetid>84fb3cd4-7f8e-4816-a5d2-2315982c7bb6</subsheetid><narrative>This page is only used to reset global data items</narrative><display x="-165" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="0e1a9e08-14cf-4730-9162-43a40ee338e3" name="Start" type="Start"><subsheetid>84fb3cd4-7f8e-4816-a5d2-2315982c7bb6</subsheetid><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>34bcbfcf-5bed-4798-aa51-99606fde2197</onsuccess></stage><stage stageid="34bcbfcf-5bed-4798-aa51-99606fde2197" name="End" type="End"><subsheetid>84fb3cd4-7f8e-4816-a5d2-2315982c7bb6</subsheetid><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="a6d75fba-2cff-44be-aff0-6f8c08a65c87" name="Exception Type" type="Data"><subsheetid>84fb3cd4-7f8e-4816-a5d2-2315982c7bb6</subsheetid><display x="-165" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="9190daa6-48cd-4ae4-838c-43c87806d755" name="Exception Detail" type="Data"><subsheetid>84fb3cd4-7f8e-4816-a5d2-2315982c7bb6</subsheetid><display x="-165" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="a44ce8e3-dcd3-4dbb-9049-eff3258e45ca" name="Note4" type="Note"><subsheetid>84fb3cd4-7f8e-4816-a5d2-2315982c7bb6</subsheetid><narrative>You can take the opportunity when traversing this page to confirm that the target applications are on the correct screen ready for processing the next case.</narrative><display x="120" y="-45" w="150" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF00FF" /></stage><stage stageid="13f4bccf-d215-4ff6-bc6f-50e149d5b73a" name="Mark Item As Exception" type="SubSheetInfo"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>Marks the current work queue item as an exception</narrative><display x="-510" y="-135" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="ccc9e276-09d0-4265-9606-3a09e15cdf23" name="Start" type="Start"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="15" y="-120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>1add66b5-f560-465a-93d1-92b27c2d0300</onsuccess></stage><stage stageid="f492dc40-f6c8-476a-bf0a-c0be8c51d6c3" name="Retry Exception?" type="Decision"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="15" y="30" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="Lower([Exception Type])=&quot;system exception&quot; OR Lower([Exception Type])=&quot;internal&quot;" /><ontrue>d682c93a-c50e-4c21-bb78-35fc1a07b205</ontrue><onfalse>31ce74ec-cc02-46fa-899b-583036557383</onfalse></stage><stage stageid="b026afdd-0984-4ad9-8e63-b0434e35a652" name="Previous Exception?" type="Decision"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="15" y="300" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Previous Exception Detail]=[Exception Detail]" /><ontrue>debcb67c-7a1f-4b8f-82d9-b37edfe306b6</ontrue><onfalse>b66912d2-113d-4657-822a-011c1eb49f40</onfalse></stage><stage stageid="5bb974a1-8dfe-4558-b57a-c1322e8823c6" name="Previous Exception Detail" type="Data"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="-315" y="225" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /></stage><stage stageid="debcb67c-7a1f-4b8f-82d9-b37edfe306b6" name="Count" type="Calculation"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="15" y="375" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>38eacdc9-11c0-4a3c-848c-aaf907e84325</onsuccess><calculation expression="1+ [Consecutive Exception Count]" stage="Consecutive Exception Count" /></stage><stage stageid="1f0d4dbf-a869-417b-a8ca-02ae7285d66b" name="Consecutive Exception Count" type="Data"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="-315" y="255" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue></stage><stage stageid="38eacdc9-11c0-4a3c-848c-aaf907e84325" name="Limit?" type="Decision"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="15" y="450" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Consecutive Exception Count]&gt;=[Consecutive Exception Limit]" /><ontrue>618c5e53-9c12-4a3e-aa50-7735663c0d4a</ontrue><onfalse>8bbb4e4c-c73d-49fe-b7bb-ec9a4cc6f6c0</onfalse></stage><stage stageid="f1cc8cf3-27a1-4c6f-b4da-8483809b8783" name="TERMINATE" type="Exception"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="15" y="690" w="120" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF0000" /><exception type="" detail="[Consecutive Exception Limit] &amp; &quot; consecutive incidents of &quot; &amp; [Exception Type] &amp; &quot;: &quot; &amp; [Exception Detail]" /></stage><stage stageid="303a5c4d-45b2-4af6-a3de-55eb1c3f9a07" name="Consecutive Exception Limit" type="Data"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="-315" y="285" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>3</initialvalue><alwaysinit /></stage><stage stageid="9015d30c-5e37-453b-8f54-8a011bb125aa" name="End2" type="End"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="405" y="450" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="0e056d03-048b-4c4b-b932-eebe9244531b" name="Reset Consecutive Exception Indicators" type="MultipleCalculation"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="405" y="300" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>9015d30c-5e37-453b-8f54-8a011bb125aa</onsuccess><steps><calculation expression="[Exception Detail]" stage="Previous Exception Detail" /><calculation expression="0" stage="Consecutive Exception Count" /></steps></stage><stage stageid="618c5e53-9c12-4a3e-aa50-7735663c0d4a" name="Stop the process because consecutive exceptions are occuring" type="Note"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>The consecutive exception limit has been reached, so throw a new exception to terminate the process.</narrative><display x="15" y="585" w="120" h="90" /><font family="Tahoma" size="10" style="Regular" color="0000FF" /><onsuccess>f1cc8cf3-27a1-4c6f-b4da-8483809b8783</onsuccess></stage><stage stageid="1792b43d-610e-4ac0-9b43-e291bc1c4efc" name="New Item ID" type="Data"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="-315" y="165" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3fc27a49-b0e0-4560-8e6f-e6015c4b0e56" name="Tag Item" type="Action"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>Adds a tag to a work queue item</narrative><display x="330" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the queue item to add the tag to" expr="[Item ID]" /><input type="text" name="Tag" narrative="The tag to add to the item. Note that this cannot start with a '+' (plus) or '-' (minus) character, and cannot contain ';' (semi-colon) characters" expr="[Exception Detail]" /></inputs><onsuccess>1912a581-37aa-4521-8b45-f6ebc79727cc</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Tag Item" /></stage><stage stageid="28ac101f-8ff6-4a59-a260-5a47888df738" name="Reset Consecutive Exception Indicators" type="MultipleCalculation"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="690" y="30" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>6b71df2a-c6ff-41c5-85cc-f397d04a94e1</onsuccess><steps><calculation expression="&quot;&quot;" stage="Previous Exception Detail" /><calculation expression="0" stage="Consecutive Exception Count" /></steps></stage><stage stageid="b66912d2-113d-4657-822a-011c1eb49f40" name="Note5" type="Note"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><loginhibit /><narrative>This exception is different from the previous one.</narrative><display x="255" y="300" w="120" h="90" /><font family="Tahoma" size="10" style="Regular" color="0000FF" /><onsuccess>0e056d03-048b-4c4b-b932-eebe9244531b</onsuccess></stage><stage stageid="8bbb4e4c-c73d-49fe-b7bb-ec9a4cc6f6c0" name="Note5" type="Note"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><loginhibit /><narrative>This exception is the same as the previous one but the consecutive exception limit has not yet been reached.</narrative><display x="270" y="450" w="120" h="90" /><font family="Tahoma" size="10" style="Regular" color="0000FF" /><onsuccess>9015d30c-5e37-453b-8f54-8a011bb125aa</onsuccess></stage><stage stageid="1912a581-37aa-4521-8b45-f6ebc79727cc" name="Note5" type="Note"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><loginhibit /><narrative>Don't retry this type of exception, just mark the queue item and carry on.</narrative><display x="465" y="30" w="120" h="90" /><font family="Tahoma" size="10" style="Regular" color="0000FF" /><onsuccess>10a0dfbd-8a75-4072-af24-45439fa2fdac</onsuccess></stage><stage stageid="c632f101-e7e2-4898-aa5c-d5666652308f" name="Mark Exception" type="Action"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>Marks the item as an exception, optionally retrying it by cloning the item and returning the ID of the clone. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.</narrative><display x="15" y="225" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Exception Reason" narrative="A description of the reason for the exception" expr="[Exception Detail]" /><input type="flag" name="Retry" narrative="Whether or not to retry the item, up to the maximum number of attempts specified for the queue. Optional - if not specified, the item will be retried" expr="True" /><input type="flag" name="Keep Locked" narrative="Whether or not the clone of the item should remain locked after the exception has been registered and the item is retried. Optional - default is False" expr="False" /></inputs><outputs><output type="text" name="New Item ID" narrative="The Item ID of the newly cloned item. This item will be locked if 'Keep Locked' is True. This will be empty if no item was cloned (ie. the item was not retried." stage="New Item ID" /></outputs><onsuccess>b026afdd-0984-4ad9-8e63-b0434e35a652</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Mark Exception" /></stage><stage stageid="10a0dfbd-8a75-4072-af24-45439fa2fdac" name="Mark Exception" type="Action"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>Marks the item as an exception, optionally retrying it by cloning the item and returning the ID of the clone. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.</narrative><display x="585" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Exception Reason" narrative="A description of the reason for the exception" expr="[Exception Detail]" /><input type="flag" name="Retry" narrative="Whether or not to retry the item, up to the maximum number of attempts specified for the queue. Optional - if not specified, the item will be retried" expr="False" /><input type="flag" name="Keep Locked" narrative="Whether or not the clone of the item should remain locked after the exception has been registered and the item is retried. Optional - default is False" expr="False" /></inputs><outputs><output type="text" name="New Item ID" narrative="The Item ID of the newly cloned item. This item will be locked if 'Keep Locked' is True. This will be empty if no item was cloned (ie. the item was not retried." stage="New Item ID" /></outputs><onsuccess>28ac101f-8ff6-4a59-a260-5a47888df738</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Mark Exception" /></stage><stage stageid="6b71df2a-c6ff-41c5-85cc-f397d04a94e1" name="End1" type="End"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="795" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="bb1afe0e-681c-4977-b975-8b34c248c6c1" name="Tag Item" type="Action"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>Adds a tag to a work queue item</narrative><display x="15" y="165" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the queue item to add the tag to" expr="[Item ID]" /><input type="text" name="Tag" narrative="The tag to add to the item. Note that this cannot start with a '+' (plus) or '-' (minus) character, and cannot contain ';' (semi-colon) characters" expr="[Exception Detail]" /></inputs><onsuccess>c632f101-e7e2-4898-aa5c-d5666652308f</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Tag Item" /></stage><stage stageid="1add66b5-f560-465a-93d1-92b27c2d0300" name="System Unavailable?" type="Decision"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="15" y="-45" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="Lower([Exception Type])=&quot;system unavailable exception&quot; OR Lower([Exception Type])=&quot;login system exception&quot;" /><ontrue>5b2c06dd-ce0c-49be-8b22-75e9e16633df</ontrue><onfalse>f492dc40-f6c8-476a-bf0a-c0be8c51d6c3</onfalse></stage><stage stageid="5b2c06dd-ce0c-49be-8b22-75e9e16633df" name="Release Item" type="Action"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>Marks the item as deferred. It is unlocked, but it will not be made available for processing again until the specified time.

The attempts count for the item is reset to zero.</narrative><display x="-225" y="-45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to defer" expr="[Item ID]" /><input type="datetime" name="Until" narrative="When to resume processing the case" expr="Now()" /></inputs><onsuccess>54e4c20d-b85e-4ddc-94a7-5290f2a65960</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Defer" /></stage><stage stageid="54e4c20d-b85e-4ddc-94a7-5290f2a65960" name="TERMINATE" type="Exception"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><display x="-225" y="30" w="120" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF0000" /><exception type="" detail="[Consecutive Exception Limit] &amp; &quot; consecutive incidents of &quot; &amp; [Exception Type] &amp; &quot;: &quot; &amp; [Exception Detail]" /></stage><stage stageid="abd17aa1-d692-44cb-b5b5-f97309837f84" name="Note4" type="Note"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>Tag exception category for Blue Prism Performance reports</narrative><display x="330" y="-60" w="120" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF00FF" /><onsuccess>3fc27a49-b0e0-4560-8e6f-e6015c4b0e56</onsuccess></stage><stage stageid="d682c93a-c50e-4c21-bb78-35fc1a07b205" name="Set Status" type="Action"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="15" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="[Exception Type]" /></inputs><onsuccess>bb1afe0e-681c-4977-b975-8b34c248c6c1</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="31ce74ec-cc02-46fa-899b-583036557383" name="Set Status" type="Action"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="180" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="[Exception Type]" /></inputs><onsuccess>3fc27a49-b0e0-4560-8e6f-e6015c4b0e56</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="9c9d45e3-acb7-43ab-aa84-fe6c45fc043a" name="Note4" type="Note"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>System not working or can not log in</narrative><display x="-225" y="-150" w="90" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF00FF" /><onsuccess>1add66b5-f560-465a-93d1-92b27c2d0300</onsuccess></stage><stage stageid="4389549f-317c-48fe-8ea0-7321411a7f8d" name="Note4" type="Note"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>The case will only retry if the WQ has been configured to enable retries.</narrative><display x="-150" y="165" w="120" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF00FF" /></stage><stage stageid="10ea916e-517f-4445-aa6f-f856dbf01549" name="Note4" type="Note"><subsheetid>ce923798-afe3-4c6b-a1d5-1be7c9c3eee1</subsheetid><narrative>Check for concurrent exceptions, a system change may have occured</narrative><display x="255" y="180" w="120" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF00FF" /><onsuccess>b026afdd-0984-4ad9-8e63-b0434e35a652</onsuccess></stage><stage stageid="4a624a95-cd0b-4a9f-9ad7-a44240d01ed5" name="Mark Item As Completed" type="SubSheetInfo"><subsheetid>db402581-3b34-4654-b4c0-c731177fae7c</subsheetid><narrative>Marks the current work queue item as complete</narrative><display x="-705" y="-180" w="150"