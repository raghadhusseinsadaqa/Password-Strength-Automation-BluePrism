><loginhibit /><display x="-375" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>3</initialvalue><private /><alwaysinit /></stage><stage stageid="9a15408e-e0f1-416f-9385-28fd7ba246d5" name="Retry Count" type="Data"><subsheetid>1c4c06c3-f979-4280-8c03-9acf8d05e28f</subsheetid><loginhibit /><display x="-375" y="15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="e8844938-c438-4959-846d-b6b157e22923" name="Retry" type="Block"><subsheetid>1c4c06c3-f979-4280-8c03-9acf8d05e28f</subsheetid><loginhibit onsuccess="true" /><display x="-450" y="-60" w="150" h="105" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="9560a552-4732-4bcf-bf16-079548962520" name="ENV-P-017- Automated_Password Strength_Analysis and Reporting-Chrome" type="Data"><subsheetid>1c4c06c3-f979-4280-8c03-9acf8d05e28f</subsheetid><loginhibit onsuccess="true" /><display x="-375" y="120" w="210" h="60" /><datatype>text</datatype><initialvalue xml:space="preserve">chrome</initialvalue><alwaysinit /></stage><stage stageid="b3bfd963-88b4-4164-a3d2-4483b8462c6d" name="ENV-P-017- Automated_Password Strength_Analysis and Reporting-URL" type="Data"><subsheetid>1c4c06c3-f979-4280-8c03-9acf8d05e28f</subsheetid><loginhibit onsuccess="true" /><display x="-375" y="195" w="210" h="60" /><datatype>text</datatype><initialvalue xml:space="preserve">https://www.kaggle.com/account/login?phase=startSignInTab&amp;returnUrl=%2Fcookies</initialvalue><private /><alwaysinit /></stage><stage stageid="f3d50c6b-df19-48a1-911c-1986f40154d1" name="Input" type="Block"><subsheetid>1c4c06c3-f979-4280-8c03-9acf8d05e28f</subsheetid><loginhibit onsuccess="true" /><display x="-495" y="75" w="240" h="165" /><font family="Segoe UI" size="10" style="Regular" color="FF99CC" /></stage><stage stageid="e48b5998-fb19-4d34-b2cf-b21732602023" name="Add To Queue" type="SubSheetInfo"><subsheetid>ad1c7695-dff6-4904-a07f-28753c858c68</subsheetid><display x="-300" y="-210" w="150" h="90" /></stage><stage stageid="9c231279-4259-47a9-bc7d-cc46824ad854" name="Start" type="Start"><subsheetid>ad1c7695-dff6-4904-a07f-28753c858c68</subsheetid><display x="30" y="-165" /><onsuccess>9efaaed8-55c4-4e33-a798-114a1697e697</onsuccess></stage><stage stageid="9fb494e5-700c-4e48-8675-b3e059bb32c6" name="End" type="End"><subsheetid>ad1c7695-dff6-4904-a07f-28753c858c68</subsheetid><display x="30" y="240" /></stage><stage stageid="9efaaed8-55c4-4e33-a798-114a1697e697" name="Is Item In Queue" type="Action"><subsheetid>ad1c7695-dff6-4904-a07f-28753c858c68</subsheetid><loginhibit onsuccess="true" /><narrative>Check if an item with the given key is already in the queue</narrative><display x="30" y="-90" w="120" h="30" /><inputs><input type="text" name="Queue Name" friendlyname="Queue Name" narrative="The name of the queue to check" expr="[QueueName]" /><input type="text" name="Key" friendlyname="Key" narrative="The key to check." expr="&quot;password&quot;" /><input type="flag" name="Include Pending" friendlyname="Include Pending" narrative="Check any items in the queue which are currently awaiting being worked. This will include any deferred items which have a deferral date in the past and any locked items. Optional - Default is True" expr="True" /><input type="flag" name="Include Deferred" friendlyname="Include Deferred" narrative="Check any items in the queue which are currently deferred to a later date. Optional - Default is True" expr="True" /><input type="flag" name="Include Completed" friendlyname="Include Completed" narrative="Check any items in the queue which are completed. Optional - Default is True" expr="True" /><input type="flag" name="Include Terminated" friendlyname="Include Terminated" narrative="Check any items in the queue which have been fully terminated. Optional - Default is True" expr="" /></inputs><outputs><output type="collection" name="Item IDs" friendlyname="Item IDs" narrative="The Item IDs which represent the work items found with the given key" stage="" /><output type="flag" name="Result" friendlyname="Result" narrative="True if an item with the given key is in the queue, False otherwise." stage="Result" /></outputs><onsuccess>945702e2-5a89-4f0e-8791-684b9d912a36</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Is Item In Queue" /></stage><stage stageid="945702e2-5a89-4f0e-8791-684b9d912a36" name="Is Item in Queue?" type="Decision"><subsheetid>ad1c7695-dff6-4904-a07f-28753c858c68</subsheetid><display x="30" y="0" w="90" h="60" /><decision expression="[Result]" /><ontrue>e82b3dea-da3d-444c-9f3b-ca2672ce7db5</ontrue><onfalse>f4618896-2218-4af4-850c-3ddbeb708681</onfalse></stage><stage stageid="f4618896-2218-4af4-850c-3ddbeb708681" name="Add To Queue" type="Action"><subsheetid>ad1c7695-dff6-4904-a07f-28753c858c68</subsheetid><loginhibit onsuccess="true" /><narrative>The Data collection contains the items to be added to the queue. The collection may contain single or multiple rows, with each representing an item to be added.

If there is a failure during the process, the queue will be unchanged - i.e. no rows will be loaded even if the error occurred on the last one.

If Defer Until is specified, the items will not be available to be worked until then. Otherwise, they are available immediately.

If the queue has a key field defined, an item added has key data longer than the maximum permitted 255 characters, an error will occur</narrative><display x="30" y="105" /><inputs><input type="text" name="Queue Name" friendlyname="Queue Name" narrative="The name of the queue to add items to" expr="[QueueName]" /><input type="collection" name="Data" friendlyname="Data" narrative="A collection containing the data, one row for each item to be added" expr="[Top100_Rows]" /><input type="datetime" name="Defer Until" friendlyname="Defer Until" narrative="Optionally, the date/time the new item(s) should be deferred until" expr="" /><input type="number" name="Priority" friendlyname="Priority" narrative="Optionally, the priority for the new item(s). Lower numbers represent higher priorities. The default is 0." expr="" /><input type="text" name="Tags" friendlyname="Tags" narrative="Optionally, a semi-colon-separated set of tags to apply to the queue item(s)" expr="" /><input type="text" name="Status" friendlyname="Status" narrative="Optionally, the initial status required of the work queue item(s) " expr="" /><input type="number" name="Batch Size" friendlyname="Batch Size" narrative="Optionally, the batch size to use when adding many items to the queue.  A Value of 0 will process all items in one batch.  An empty field will use the default batch size of 1000." expr=""><validator type="BluePrism.AutomateProcessCore.RangeParameterValidation" parameter="0:25000" /></input><input type="timespan" name="SLA" friendlyname="SLA" narrative="Optionally, the SLA that specifies the agreed-upon response or resolution time for the item(s), indicating the maximum acceptable duration for processing them based on their criticality or urgency.&#xD;&#xA;SLA values are provided as a timespan with a minimum value of 1 second and a maximum value of 999 days, 23 hours, 59 minutes, and 59 seconds.&#xD;&#xA;There is no default value for SLA if one is not provided." expr="" /><input type="datetime" name="SLA Deadline" friendlyname="SLA Deadline" narrative="Optionally, the SLA Deadline specifies the agreed-upon response or resolution time for the item(s),&#xD;&#xA;indicating an explicitly set date for addressing them based on their criticality or urgency.&#xD;&#xA;SLA Deadline values are provided as a DateTime which must be less than 1000 days in the future.&#xD;&#xA;There is no default value for SLA Deadline if one is not provided. This value will override any&#xD;&#xA;value provided in the SLA input." expr="" /></inputs><outputs><output type="collection" name="Item IDs" friendlyname="Item IDs" narrative="The IDs of the items which have been added to the queue, in the order of the collection of data passed that was input" stage="Item IDs" /></outputs><onsuccess>9fb494e5-700c-4e48-8675-b3e059bb32c6</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Add To Queue" /></stage><stage stageid="e82b3dea-da3d-444c-9f3b-ca2672ce7db5" name="Anchor2" type="Anchor"><subsheetid>ad1c7695-dff6-4904-a07f-28753c858c68</subsheetid><loginhibit onsuccess="true" /><display x="-120" y="0" w="10" h="10" /><onsuccess>0bc8e452-179b-4c91-bf12-a27e0dca5a04</onsuccess></stage><stage stageid="0bc8e452-179b-4c91-bf12-a27e0dca5a04" name="Anchor3" type="Anchor"><subsheetid>ad1c7695-dff6-4904-a07f-28753c858c68</subsheetid><loginhibit onsuccess="true" /><display x="-120" y="240" w="10" h="10" /><onsuccess>9fb494e5-700c-4e48-8675-b3e059bb32c6</onsuccess></stage><stage stageid="560c7266-d656-4c84-87b4-8ae9d01c3ac8" name="Result" type="Data"><subsheetid>ad1c7695-dff6-4904-a07f-28753c858c68</subsheetid><display x="-240" y="135" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ed746d04-9809-4947-81aa-3039b8062bfa" name="Recover" type="Recover"><subsheetid>ad1c7695-dff6-4904-a07f-28753c858c68</subsheetid><loginhibit /><display x="135" y="-15" /><onsuccess>b2c4d1a7-67d1-4a85-bae0-2c37f25ec38d</onsuccess></stage><stage st